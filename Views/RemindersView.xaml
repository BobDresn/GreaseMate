<UserControl x:Class="GreaseMate.Views.RemindersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="30">

        <StackPanel>

            <TextBlock Text="Reminders"
                       FontSize="30"
                       FontWeight="Bold"/>

            <TextBlock Text="Upcoming maintenance and service reminders."
                       FontSize="14"
                       Foreground="#777"
                       Margin="0,5,0,25"/>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="25">

                <TextBlock Text="Upcoming reminders will appear here."
                           Foreground="#777"/>

            </Border>

        </StackPanel>

    </Grid>

</UserControl>