<UserControl x:Class="GreaseMate.Views.RemindersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Grid Margin="30">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" Margin="0,0,0,22">
			<StackPanel>
				<TextBlock Text="Reminders" FontSize="30" FontWeight="Bold"/>
				<TextBlock Text="Schedule upcoming service and control when it becomes urgent."
                           FontSize="14" Foreground="#777" Margin="0,5,0,0"/>
			</StackPanel>
			<Border HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="#FFF3D9" CornerRadius="10" Padding="14,8">
				<TextBlock Text="{Binding UpcomingMaintenanceCount, StringFormat={}{0} scheduled}"
                           Foreground="#8A5A00" FontWeight="SemiBold"/>
			</Border>
		</Grid>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="350"/>
				<ColumnDefinition Width="20"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- Scheduling form -->
			<Border Grid.Column="0" Background="White" CornerRadius="12" Padding="25">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel>
						<TextBlock FontSize="20" FontWeight="SemiBold">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Text" Value="Schedule Maintenance"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsEditingReminder}" Value="True">
											<Setter Property="Text" Value="Edit Schedule"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
						<TextBlock Text="Use a due date, mileage target, or both."
                                   Foreground="#777" Margin="0,5,0,18"/>

						<TextBlock Text="Vehicle *" FontWeight="SemiBold"/>
						<ComboBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding ReminderVehicle}"
                                  DisplayMemberPath="DisplayName" Height="36" Padding="7" Margin="0,5,0,13"/>

						<TextBlock Text="Service type *" FontWeight="SemiBold"/>
						<TextBox Text="{Binding ReminderServiceType, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" Padding="8" Margin="0,5,0,13"/>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="12"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<StackPanel>
								<TextBlock Text="Due date" FontWeight="SemiBold"/>
								<DatePicker SelectedDate="{Binding ReminderDueDate}" Height="36" Margin="0,5,0,13"/>
							</StackPanel>
							<StackPanel Grid.Column="2">
								<TextBlock Text="Due mileage" FontWeight="SemiBold"/>
								<TextBox Text="{Binding ReminderDueMileage, UpdateSourceTrigger=PropertyChanged}"
                                         Height="36" Padding="8" Margin="0,5,0,13"/>
							</StackPanel>
						</Grid>

						<TextBlock Text="Repeat after completion" FontWeight="SemiBold" Margin="0,2,0,8"/>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="12"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<StackPanel>
								<TextBlock Text="Every (months)"/>
								<TextBox Text="{Binding ReminderRepeatMonths, UpdateSourceTrigger=PropertyChanged}"
                                         Height="36" Padding="8" Margin="0,5,0,13"/>
							</StackPanel>
							<StackPanel Grid.Column="2">
								<TextBlock Text="Every (miles)"/>
								<TextBox Text="{Binding ReminderRepeatMileage, UpdateSourceTrigger=PropertyChanged}"
                                         Height="36" Padding="8" Margin="0,5,0,13"/>
							</StackPanel>
						</Grid>

						<TextBlock Text="Notes" FontWeight="SemiBold"/>
						<TextBox Text="{Binding ReminderNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Height="60" Padding="8" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Margin="0,5,0,8"/>

						<TextBlock Text="{Binding ReminderFormError}" Foreground="#C62828"
                                   TextWrapping="Wrap" MinHeight="20" Margin="0,8,0,4"/>

						<Button Content="Create Reminder" Command="{Binding AddReminderCommand}"
                                Height="42" Background="#171A1F" Foreground="White" FontWeight="SemiBold">
							<Button.Style>
								<Style TargetType="Button">
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsEditingReminder}" Value="True">
											<Setter Property="Visibility" Value="Collapsed"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
						</Button>

						<Grid>
							<Grid.Style>
								<Style TargetType="Grid">
									<Setter Property="Visibility" Value="Collapsed"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsEditingReminder}" Value="True">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Grid.Style>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="10"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<Button Content="Save Changes" Command="{Binding UpdateReminderCommand}"
                                    Height="42" Background="#171A1F" Foreground="White" FontWeight="SemiBold"/>
							<Button Grid.Column="2" Content="Cancel" Command="{Binding CancelReminderEditCommand}" Height="42"/>
						</Grid>
					</StackPanel>
				</ScrollViewer>
			</Border>

			<Grid Grid.Column="2">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="16"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<!-- Quick settings -->
				<Border Background="White" CornerRadius="12" Padding="20">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<StackPanel>
							<TextBlock Text="Quick Reminder Settings" FontSize="18" FontWeight="SemiBold"/>
							<TextBlock Text="Flag scheduled work this far before its due target."
                                       Foreground="#777" Margin="0,4,0,12"/>
							<StackPanel Orientation="Horizontal">
								<Button Content="7 days" Command="{Binding SetReminderLeadTimeCommand}"
                                        CommandParameter="7" Padding="12,6" Margin="0,0,8,0"/>
								<Button Content="30 days" Command="{Binding SetReminderLeadTimeCommand}"
                                        CommandParameter="30" Padding="12,6" Margin="0,0,8,0"/>
								<Button Content="60 days" Command="{Binding SetReminderLeadTimeCommand}"
                                        CommandParameter="60" Padding="12,6"/>
							</StackPanel>
						</StackPanel>
						<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
							<StackPanel Margin="0,0,12,0">
								<TextBlock Text="Lead days" FontWeight="SemiBold"/>
								<TextBox Text="{Binding DefaultReminderDays, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80" Height="34" Padding="7" Margin="0,5,0,0"/>
							</StackPanel>
							<StackPanel Margin="0,0,12,0">
								<TextBlock Text="Lead miles" FontWeight="SemiBold"/>
								<TextBox Text="{Binding DefaultReminderMiles, UpdateSourceTrigger=PropertyChanged}"
                                         Width="90" Height="34" Padding="7" Margin="0,5,0,0"/>
							</StackPanel>
							<StackPanel VerticalAlignment="Bottom">
								<Button Content="Save" Command="{Binding SaveReminderSettingsCommand}"
                                        Height="34" Padding="16,0" Background="#171A1F" Foreground="White"/>
								<TextBlock Text="{Binding ReminderSettingsMessage}" Foreground="#2B7A4B"
                                           FontSize="11" Margin="0,4,0,0"/>
							</StackPanel>
						</StackPanel>
					</Grid>
				</Border>

				<!-- Schedule cards -->
				<Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<Grid Margin="0,0,0,14">
							<TextBlock Text="Scheduled Maintenance" FontSize="19" FontWeight="SemiBold"/>
							<TextBlock Text="Select a card to complete, edit, or remove it."
                                       Foreground="#777" HorizontalAlignment="Right" VerticalAlignment="Center"/>
						</Grid>

						<ListBox Grid.Row="1" ItemsSource="{Binding MaintenanceReminders}"
                                 SelectedItem="{Binding SelectedReminder}"
                                 Background="Transparent" BorderThickness="0">
							<ListBox.ItemContainerStyle>
								<Style TargetType="ListBoxItem">
									<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
									<Setter Property="Padding" Value="0"/>
									<Setter Property="Margin" Value="0,0,0,10"/>
								</Style>
							</ListBox.ItemContainerStyle>
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Border Background="#F8F9FB" BorderBrush="#E3E6EA"
                                            BorderThickness="1" CornerRadius="10" Padding="16">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"/>
											</Grid.ColumnDefinitions>
											<StackPanel>
												<TextBlock Text="{Binding ServiceType}" FontSize="16" FontWeight="Bold"/>
												<TextBlock Text="{Binding VehicleDisplay}" Foreground="#68707B" Margin="0,3,0,10"/>
												<StackPanel Orientation="Horizontal">
													<Border Background="#EAF0FA" CornerRadius="8" Padding="9,4" Margin="0,0,8,0">
														<TextBlock Text="{Binding DueDateDisplay}" Foreground="#34558B"/>
													</Border>
													<Border Background="#F0F2F5" CornerRadius="8" Padding="9,4">
														<TextBlock Text="{Binding DueMileageDisplay}" Foreground="#4E5661"/>
													</Border>
												</StackPanel>
											</StackPanel>
											<Border Grid.Column="1" Background="#FFF3D9" CornerRadius="10"
                                                    Padding="10,5" VerticalAlignment="Top">
												<TextBlock Text="{Binding StatusDisplay}" Foreground="#8A5A00"
                                                           FontSize="11" FontWeight="Bold"/>
											</Border>
										</Grid>
									</Border>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>

						<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
							<Button Content="Edit" Command="{Binding EditReminderCommand}" Height="38" Padding="18,0"/>
							<Button Content="Remove" Command="{Binding RemoveReminderCommand}"
                                    Height="38" Padding="18,0" Margin="10,0,0,0" Foreground="#B71C1C"/>
							<Button Content="Mark Complete" Command="{Binding CompleteReminderCommand}"
                                    Height="38" Padding="18,0" Margin="10,0,0,0"
                                    Background="#171A1F" Foreground="White"/>
						</StackPanel>
					</Grid>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
