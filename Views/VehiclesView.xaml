<UserControl x:Class="GreaseMate.Views.VehiclesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="30">

        <StackPanel>

            <TextBlock Text="Vehicles"
                       FontSize="30"
                       FontWeight="Bold"/>

            <TextBlock Text="Manage your vehicles."
                       FontSize="14"
                       Foreground="#777"
                       Margin="0,5,0,25"/>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="25">

                <StackPanel>

                    <TextBlock Text="Your Vehicles"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Vehicle management will appear here."
                               Foreground="#777"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </Grid>

</UserControl>