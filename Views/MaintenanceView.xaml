<UserControl x:Class="GreaseMate.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Grid Margin="30">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" Margin="0,0,0,22">
			<StackPanel>
				<TextBlock Text="Maintenance" FontSize="30" FontWeight="Bold"/>
				<TextBlock Text="See upcoming work and keep a permanent service history."
                           FontSize="14" Foreground="#777" Margin="0,5,0,0"/>
			</StackPanel>
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
				<Border Background="#FFF3D9" CornerRadius="10" Padding="14,8" Margin="0,0,10,0">
					<TextBlock Text="{Binding UpcomingMaintenanceCount, StringFormat={}{0} upcoming}"
                               Foreground="#8A5A00" FontWeight="SemiBold"/>
				</Border>
				<Border Background="#EAF6EF" CornerRadius="10" Padding="14,8">
					<TextBlock Text="{Binding MaintenanceRecords.Count, StringFormat={}{0} completed}"
                               Foreground="#23633B" FontWeight="SemiBold"/>
				</Border>
			</StackPanel>
		</Grid>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="350"/>
				<ColumnDefinition Width="20"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- Completed maintenance form -->
			<Border Grid.Column="0" Background="White" CornerRadius="12" Padding="25">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel>
						<TextBlock FontSize="20" FontWeight="SemiBold">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Text" Value="Record Completed Work"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsEditingMaintenance}" Value="True">
											<Setter Property="Text" Value="Edit Service Record"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
						<TextBlock Text="Add service that has already been performed."
                                   Foreground="#777" TextWrapping="Wrap" Margin="0,5,0,18"/>

						<TextBlock Text="Vehicle *" FontWeight="SemiBold"/>
						<ComboBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding MaintenanceVehicle}"
                                  DisplayMemberPath="DisplayName" Height="36" Padding="7" Margin="0,5,0,13"/>

						<TextBlock Text="Service type *" FontWeight="SemiBold"/>
						<TextBox Text="{Binding ServiceType, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" Padding="8" Margin="0,5,0,13"/>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="12"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<StackPanel>
								<TextBlock Text="Service date *" FontWeight="SemiBold"/>
								<DatePicker SelectedDate="{Binding ServiceDate}" Height="36" Margin="0,5,0,13"/>
							</StackPanel>
							<StackPanel Grid.Column="2">
								<TextBlock Text="Mileage *" FontWeight="SemiBold"/>
								<TextBox Text="{Binding ServiceMileage, UpdateSourceTrigger=PropertyChanged}"
                                         Height="36" Padding="8" Margin="0,5,0,13"/>
							</StackPanel>
						</Grid>

						<TextBlock Text="Cost" FontWeight="SemiBold"/>
						<TextBox Text="{Binding ServiceCost, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                 Height="36" Padding="8" Margin="0,5,0,13"/>

						<TextBlock Text="Notes" FontWeight="SemiBold"/>
						<TextBox Text="{Binding ServiceNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Height="58" Padding="8" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Margin="0,5,0,13"/>

						<TextBlock Text="Schedule the next service" FontWeight="SemiBold" Margin="0,3,0,8"/>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="12"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<StackPanel>
								<TextBlock Text="Due date"/>
								<DatePicker SelectedDate="{Binding NextServiceDate}" Height="36" Margin="0,5,0,0"/>
							</StackPanel>
							<StackPanel Grid.Column="2">
								<TextBlock Text="Due mileage"/>
								<TextBox Text="{Binding NextServiceMileage, UpdateSourceTrigger=PropertyChanged}"
                                         Height="36" Padding="8" Margin="0,5,0,0"/>
							</StackPanel>
						</Grid>

						<TextBlock Text="{Binding MaintenanceFormError}" Foreground="#C62828"
                                   TextWrapping="Wrap" MinHeight="20" Margin="0,12,0,4"/>

						<Button Content="Save Completed Work" Command="{Binding AddMaintenanceCommand}"
                                Height="42" Background="#171A1F" Foreground="White" FontWeight="SemiBold">
							<Button.Style>
								<Style TargetType="Button">
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsEditingMaintenance}" Value="True">
											<Setter Property="Visibility" Value="Collapsed"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
						</Button>

						<Grid>
							<Grid.Style>
								<Style TargetType="Grid">
									<Setter Property="Visibility" Value="Collapsed"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsEditingMaintenance}" Value="True">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Grid.Style>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="10"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<Button Content="Save Changes" Command="{Binding UpdateMaintenanceCommand}"
                                    Height="42" Background="#171A1F" Foreground="White" FontWeight="SemiBold"/>
							<Button Grid.Column="2" Content="Cancel" Command="{Binding CancelMaintenanceEditCommand}" Height="42"/>
						</Grid>
					</StackPanel>
				</ScrollViewer>
			</Border>

			<!-- Upcoming and completed collections -->
			<Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20">
				<TabControl Background="Transparent" BorderThickness="0">
					<TabItem Header="Upcoming">
						<Grid Margin="0,18,0,0">
							<Grid.RowDefinitions>
								<RowDefinition Height="*"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>
							<ListBox ItemsSource="{Binding MaintenanceReminders}"
                                     SelectedItem="{Binding SelectedReminder}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
								<ListBox.ItemContainerStyle>
									<Style TargetType="ListBoxItem">
										<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
										<Setter Property="Padding" Value="0"/>
										<Setter Property="Margin" Value="0,0,0,10"/>
										<Setter Property="Background" Value="Transparent"/>
										<Setter Property="BorderThickness" Value="0"/>
									</Style>
								</ListBox.ItemContainerStyle>
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Border Background="#F8F9FB" BorderBrush="#E3E6EA"
                                                BorderThickness="1" CornerRadius="10" Padding="16">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="Auto"/>
												</Grid.ColumnDefinitions>
												<StackPanel>
													<TextBlock Text="{Binding ServiceType}" FontSize="16" FontWeight="Bold"/>
													<TextBlock Text="{Binding VehicleDisplay}" Foreground="#68707B" Margin="0,3,0,10"/>
													<StackPanel Orientation="Horizontal">
														<TextBlock Text="{Binding DueDateDisplay}" Foreground="#3E526C"/>
														<TextBlock Text="  •  " Foreground="#A0A5AC"/>
														<TextBlock Text="{Binding DueMileageDisplay}" Foreground="#3E526C"/>
													</StackPanel>
												</StackPanel>
												<Border Grid.Column="1" Background="#FFF3D9" CornerRadius="10"
                                                        Padding="10,5" VerticalAlignment="Top">
													<TextBlock Text="{Binding StatusDisplay}" Foreground="#8A5A00"
                                                               FontSize="11" FontWeight="Bold"/>
												</Border>
											</Grid>
										</Border>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
							<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
								<Button Content="Manage Schedule" Command="{Binding ShowRemindersCommand}" Height="38" Padding="16,0"/>
								<Button Content="Mark Complete" Command="{Binding CompleteReminderCommand}"
                                        Height="38" Padding="16,0" Margin="10,0,0,0"
                                        Background="#171A1F" Foreground="White"/>
							</StackPanel>
						</Grid>
					</TabItem>

					<TabItem Header="Completed History">
						<Grid Margin="0,18,0,0">
							<Grid.RowDefinitions>
								<RowDefinition Height="*"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>
							<ListBox ItemsSource="{Binding MaintenanceRecords}"
                                     SelectedItem="{Binding SelectedMaintenanceRecord}"
                                     Background="Transparent" BorderThickness="0">
								<ListBox.ItemContainerStyle>
									<Style TargetType="ListBoxItem">
										<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
										<Setter Property="Padding" Value="0"/>
										<Setter Property="Margin" Value="0,0,0,10"/>
									</Style>
								</ListBox.ItemContainerStyle>
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Border Background="#F8F9FB" BorderBrush="#E3E6EA"
                                                BorderThickness="1" CornerRadius="10" Padding="16">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="Auto"/>
												</Grid.ColumnDefinitions>
												<StackPanel>
													<TextBlock Text="{Binding ServiceType}" FontSize="16" FontWeight="Bold"/>
													<TextBlock Text="{Binding VehicleDisplay}" Foreground="#68707B" Margin="0,3,0,9"/>
													<StackPanel Orientation="Horizontal">
														<TextBlock Text="{Binding ServiceDate, StringFormat=d}"/>
														<TextBlock Text="  •  "/>
														<TextBlock Text="{Binding Mileage, StringFormat={}{0:N0} mi}"/>
													</StackPanel>
												</StackPanel>
												<StackPanel Grid.Column="1" HorizontalAlignment="Right">
													<TextBlock Text="{Binding Cost, StringFormat=C}" FontSize="17" FontWeight="SemiBold"/>
													<TextBlock Text="COMPLETED" Foreground="#2B7A4B" FontSize="10"
                                                               FontWeight="Bold" HorizontalAlignment="Right" Margin="0,6,0,0"/>
												</StackPanel>
											</Grid>
										</Border>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
							<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
								<Button Content="Edit Selected" Command="{Binding EditMaintenanceCommand}" Height="38" Padding="16,0"/>
								<Button Content="Remove Selected" Command="{Binding RemoveMaintenanceCommand}"
                                        Height="38" Padding="16,0" Margin="10,0,0,0" Foreground="#B71C1C"/>
							</StackPanel>
						</Grid>
					</TabItem>
				</TabControl>
			</Border>
		</Grid>
	</Grid>
</UserControl>
