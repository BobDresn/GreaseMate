<UserControl x:Class="GreaseMate.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Reports" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Filter maintenance history, review spending, and export your records."
                           FontSize="14" Foreground="#777" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Content="Export CSV" Command="{Binding ExportReportCsvCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Height="40" Padding="18,0"
                    Background="#171A1F" Foreground="White" FontWeight="SemiBold"/>
        </Grid>
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Vehicle" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding ReportVehicle}"
                              DisplayMemberPath="DisplayName" Height="36" Padding="7" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="From" FontWeight="SemiBold"/>
                    <DatePicker SelectedDate="{Binding ReportStartDate}" Height="36" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Through" FontWeight="SemiBold"/>
                    <DatePicker SelectedDate="{Binding ReportEndDate}" Height="36" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="5" Content="All Vehicles" Command="{Binding ClearReportVehicleCommand}"
                        Height="36" Padding="14,0" Margin="16,22,0,0"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="SERVICES" Foreground="#777" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ReportServiceCount}" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="TOTAL SPENT" Foreground="#777" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ReportTotalCost, StringFormat=C}" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Background="White" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="AVERAGE SERVICE" Foreground="#777" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ReportAverageCost, StringFormat=C}" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="Maintenance History" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ReportStatusMessage}" Foreground="#8A5A00" HorizontalAlignment="Right"/>
                </Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding ReportRecords}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleDisplay}" Width="2*"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding ServiceDate, StringFormat=d}" Width="*"/>
                        <DataGridTextColumn Header="Service" Binding="{Binding ServiceType}" Width="2*"/>
                        <DataGridTextColumn Header="Mileage" Binding="{Binding Mileage, StringFormat={}{0:N0}}" Width="*"/>
                        <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat=C}" Width="*"/>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
