<Window x:Class="GreaseMate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GreaseMate"
        Width="1200"
        Height="800"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="#171A1F">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <StackPanel Grid.Row="0"
                            Margin="25,20"
                            VerticalAlignment="Center">

                    <TextBlock Text="GreaseMate"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"/>

                    <TextBlock Text="Vehicle Maintenance"
                               Foreground="#888888"
                               FontSize="12"/>

                </StackPanel>

                <!-- NAVIGATION -->
                <StackPanel Grid.Row="1"
                            Margin="15,10">

                    <Button Content="Dashboard"
                            Command="{Binding ShowDashboardCommand}"
                            Height="50"
                            Margin="0,5"/>

                    <Button Content="Vehicles"
                            Command="{Binding ShowVehiclesCommand}"
                            Height="50"
                            Margin="0,5"/>

                    <Button Content="Maintenance"
                            Command="{Binding ShowMaintenanceCommand}"
                            Height="50"
                            Margin="0,5"/>

                    <Button Content="Reminders"
                            Command="{Binding ShowRemindersCommand}"
                            Height="50"
                            Margin="0,5"/>

                    <Button Content="Reports"
                            Command="{Binding ShowReportsCommand}"
                            Height="50"
                            Margin="0,5"/>

                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="GreaseMate v1.0"
                           Foreground="#666"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1"
              Background="#F3F4F6">

            <ContentControl Content="{Binding CurrentView}"/>

        </Grid>

    </Grid>

</Window>